<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hande_gripper_aquarium</name>
  <version>0.1.0</version>
  <description>Aquarium gateway and skill configuration for Robotiq Hand-E gripper</description>
  <maintainer email="morganquigley@google.com">Morgan Quigley</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>aquarium_gateway</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager</depend>
  <depend>parallel_gripper_controller</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>robot_state_publisher</depend>
  <depend>sensor_msgs</depend>
  <depend>robotiq_hande_description</depend>
  <depend>robotiq_hande_driver</depend>
  <depend>xacro</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
