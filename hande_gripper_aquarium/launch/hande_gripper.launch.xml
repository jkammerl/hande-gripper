<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_fake_hardware" default="false" />
  <group>
    <push-ros-namespace namespace="gripper" />

    <node pkg="controller_manager" exec="ros2_control_node" name="controller_manager" output="both">
      <param from="$(find-pkg-share robotiq_hande_driver)/bringup/config/hande_controller.yaml" />
      <remap from="/robot_description" to="robot_description" />
    </node>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="both">
      <param from="$(find-pkg-share hande_gripper_aquarium)/config/hande_controller.yaml" />
      <param name="robot_description" type="str" value="$(command 'xacro $(find-pkg-share robotiq_hande_description)/urdf/robotiq_hande_gripper.urdf.xacro use_fake_hardware:=$(var use_fake_hardware) tty_port:=/dev/ttyUSB0 create_socat_tty:=false tf_prefix:= ')" />
    </node>

    <node pkg="controller_manager" exec="spawner" output="both" args="joint_state_broadcaster -c /gripper/controller_manager --param-file $(find-pkg-share hande_gripper_aquarium)/config/hande_controller.yaml" />

    <node pkg="controller_manager" exec="spawner" output="both" args="gripper_action_controller -c /gripper/controller_manager --param-file $(find-pkg-share hande_gripper_aquarium)/config/hande_controller.yaml" />
  </group>
</launch>
