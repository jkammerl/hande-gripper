<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aquarium_gateway</name>
  <version>0.1.0</version>
  <description>Maps Zenoh queryables and gRPC calls with protobuf payloads to ROS 2 action clients, as configured in an aquarium.yaml file</description>
  <maintainer email="julius@kammerl.de">Julius Kammerl</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <exec_depend>python3-grpcio</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>control_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
