<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hande_gripper_sim_driver</name>
  <version>0.1.0</version>
  <description>Simulated ROS 2 Action Server drop-in driver for Robotiq Hand-E gripper</description>
  <maintainer email="julius@kammerl.de">Julius Kammerl</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <exec_depend>python3-grpcio</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
